generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["giemens_crm"]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST

  @@schema("giemens_crm")
}

enum BusinessDivision {
  JURIVANA
  TECHNOLOGY
  ENGINEERING
  COMMERCE
  CONSULTING
  ACADEMY
  CORPORATE

  @@schema("giemens_crm")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@schema("giemens_crm")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       User[]

  @@map("roles")
  @@schema("giemens_crm")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  name         String     @db.VarChar(120)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  activities   Activity[]
  sessions     Session[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([roleId])
  @@map("users")
  @@schema("giemens_crm")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("giemens_crm")
}

model AuthRateLimit {
  keyHash         String   @id @map("key_hash") @db.Char(64)
  attempts        Int      @default(0)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([windowStartedAt])
  @@map("auth_rate_limits")
  @@schema("giemens_crm")
}

model Lead {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(120)
  email     String           @db.VarChar(254)
  phone     String?          @db.VarChar(24)
  company   String?          @db.VarChar(160)
  message   String           @db.VarChar(5000)
  division  BusinessDivision
  source    String           @db.VarChar(100)
  status    LeadStatus       @default(NEW)
  subject   String           @db.VarChar(180)
  category  String           @db.VarChar(80)
  activities Activity[]
  customer  Customer?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([division, status, createdAt])
  @@index([email])
  @@map("leads")
  @@schema("giemens_crm")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar(80)
  details   Json?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([leadId, createdAt])
  @@map("activities")
  @@schema("giemens_crm")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(200)
  email     String?   @db.VarChar(254)
  phone     String?   @db.VarChar(24)
  leadId    String?   @unique @map("lead_id") @db.Uuid
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@map("customers")
  @@schema("giemens_crm")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(200)
  description String?   @db.VarChar(5000)
  customerId  String?   @map("customer_id") @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId])
  @@map("projects")
  @@schema("giemens_crm")
}

model Task {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String?    @map("project_id") @db.Uuid
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String     @db.VarChar(240)
  details   String?    @db.VarChar(5000)
  status    TaskStatus @default(OPEN)
  dueAt     DateTime?  @map("due_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status])
  @@index([status, dueAt])
  @@map("tasks")
  @@schema("giemens_crm")
}
