{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/contact.ts": {
      "maxDuration": 10
    },
    "api/leads.ts": {
      "includeFiles": "src/features/leads/**/*.ts"
    },
    "api/crm.ts": {
      "maxDuration": 15
    },
    "api/documents.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/businesses", "destination": "/businesses/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/jurivana", "destination": "/jurivana/index.html" },
    { "source": "/technology", "destination": "/technology/index.html" },
    { "source": "/ecommerce", "destination": "/ecommerce/index.html" },
    { "source": "/engineering", "destination": "/engineering/index.html" },
    { "source": "/marketing", "destination": "/marketing/index.html" },
    { "source": "/consultancy", "destination": "/consultancy/index.html" },
    { "source": "/careers", "destination": "/careers/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/ecosystem/jurivana", "destination": "/ecosystem/jurivana/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/disclaimer", "destination": "/disclaimer/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-K8HZdC/RJBVlqxAmswWtEiwUEPiVPo5VUOiZn8e6ziI='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://*.blob.core.windows.net; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
