{
  "name": "giemens-corporate-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-env.mjs && vite build && node scripts/prerender-routes.mjs && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "start": "node scripts/validate-runtime-env.mjs && node --experimental-strip-types --import ./server/instrumentation.ts server/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/contact.test.ts tests/leads.test.ts tests/leads-api.test.ts tests/auth.test.ts tests/http.test.ts tests/crm-api.test.ts tests/documents-api.test.ts tests/email-service.test.ts tests/clamav.test.ts tests/seed-config.test.ts tests/readiness.test.ts",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:verify": "node scripts/verify-db.mjs",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "seed:development": "node --env-file=.env.development --experimental-strip-types prisma/seed.ts",
    "env:generate": "node scripts/generate-env.mjs",
    "documents:cleanup": "node --experimental-strip-types scripts/cleanup-documents.ts",
    "email:health": "node --experimental-strip-types scripts/check-email.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@prisma/client": "^6.19.0",
    "@prisma/instrumentation": "^6.19.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prisma": "^6.19.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
